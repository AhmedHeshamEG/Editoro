{
  "id": "circle-emphasis",
  "version": 1,
  "schema": 2,
  "display_name": "تحويط · Circle",
  "category": "annotation",
  "category_color": "#FCA5A5",
  "directive_verb": "تحويط",
  "description": "A hand-drawn circle scribbled around a region of the frame, as if ringed with a marker while talking.",
  "fields": [
    {
      "name": "rect",
      "label": "Region",
      "type": "rect",
      "default": {
        "x": 0.36,
        "y": 0.3,
        "w": 0.28,
        "h": 0.3
      },
      "description": "The region to ring, in 0..1 frame coordinates."
    },
    {
      "name": "laps",
      "label": "Loops",
      "type": "number",
      "min": 1,
      "max": 3,
      "step": 0.5,
      "default": 1.5,
      "description": "How many times around. 1.5 reads most like a real scribble."
    },
    {
      "name": "colour",
      "label": "Ink colour",
      "type": "color",
      "default": "#FF6B6B",
      "description": "Ink colour of the ring, as #RRGGBB."
    }
  ],
  "full_frame": true,
  "variants": {
    "horizontal": {
      "x": 0.5,
      "y": 0.5,
      "scale": 1.0
    },
    "vertical": {
      "x": 0.5,
      "y": 0.5,
      "scale": 1.0
    }
  },
  "motion": {
    "in": {
      "type": "ease",
      "easing": "outQuart",
      "ms": 560,
      "from": {
        "opacity": 0
      }
    },
    "out": {
      "type": "ease",
      "easing": "inCubic",
      "ms": 260,
      "to": {
        "opacity": 0
      }
    }
  },
  "sfx": [
    {
      "file": "_shared/sfx/marker-stroke.wav",
      "offset": 0.02,
      "gain": 0.38
    }
  ],
  "assets": [],
  "default_duration": 2.8
}
