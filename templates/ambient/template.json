      "type": "number",
      "min": 0.05,
      "max": 1,
      "step": 0.05,
      "default": 0.35,
      "description": "Overall opacity of the layer. Keep it low; this is a texture, not a background."
    }
  ],
  "full_frame": true,
  "variants": {
    "horizontal": {
      "x": 0.5,
      "y": 0.5,
      "scale": 1.0
    },
    "vertical": {
      "x": 0.5,
      "y": 0.5,
      "scale": 1.0
    }
  },
  "motion": {
    "in": {
      "type": "ease",
      "easing": "outSine",
      "ms": 900,
      "from": {
        "opacity": 0
      }
    },
    "out": {
      "type": "ease",
      "easing": "inOutSine",
      "ms": 900,
      "to": {
        "opacity": 0
      }
    }
  },
  "sfx": [],
  "assets": [],
