{
  "id": "ambient",
  "version": 5,
  "schema": 2,
  "display_name": "Ambient",
  "category": "ambient",
  "category_color": "#4A5568",
  "directive_verb": null,
  "description": "A calm full-frame paper layer with slowly drifting light. Non-distracting; use it under long stretches of pure talking.",
  "fields": [
    {
      "name": "intensity",
