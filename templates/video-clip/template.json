{
  "id": "video-clip",
  "version": 5,
  "schema": 2,
  "display_name": "Video clip",
  "category": "video",
  "category_color": "#6C9BFF",
  "directive_verb": "ب-رول",
  "description": "An inserted b-roll clip that slides onto the desk in its own frame, with its audio mixed under the speech.",
  "fields": [
    {
      "name": "asset",
      "label": "Video clip",
      "type": "asset:video",
      "description": "MP4, MOV, MKV, WebM, M4V or AVI."
    },
    {
      "name": "clip_in",
      "label": "Start inside clip",
      "type": "number",
      "min": 0,
      "max": 3600,
      "step": 0.1,
      "default": 0,
      "control": "integer",
      "description": "Seconds into the source clip at which playback begins."
    },
    {
      "name": "volume",
      "label": "Clip audio volume",
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.8,
      "description": "0 mutes the clip; the speech track is never ducked automatically."
    }
  ],
  "variants": {
    "horizontal": {
      "x": 0.735,
      "y": 0.35,
      "scale": 1.0,
      "max_width": 0.44,
      "max_height": 0.56
    },
    "vertical": {
      "x": 0.5,
      "y": 0.3,
      "scale": 0.95,
      "max_width": 0.86,
      "max_height": 0.4
    }
  },
  "motion": {
    "in": {
      "type": "spring",
      "stiffness": 190,
      "damping": 20,
      "ms": 700,
      "from": {
        "opacity": 0,
        "scale": 0.9,
        "x": 520,
        "rotate": 4
      }
    },
    "out": {
      "type": "ease",
      "easing": "inCubic",
      "ms": 300,
      "to": {
        "opacity": 0,
        "x": 180,
        "rotate": 2
      }
    },
    "stagger": {
      "step_ms": 48,
      "elements": [
        "frame",
        "clip"
      ]
    },
    "blur": {
      "motion": true,
      "max": 9
    },
    "shadow": {
      "layers": 3,
      "elevation": 32,
      "opacity": 0.5,
      "lift": true
    }
  },
  "sfx": [
    {
      "file": "_shared/sfx/paper-slide.wav",
      "offset": 0.0,
      "gain": 0.5
    },
    {
      "file": "_shared/sfx/paper-land.wav",
      "offset": 0.3,
      "gain": 0.38
    }
  ],
  "assets": [],
  "default_duration": 6.0
}
