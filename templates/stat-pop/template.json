{
  "id": "stat-pop",
  "version": 1,
  "schema": 2,
  "display_name": "Stat",
  "category": "text",
  "category_color": "#FF9F1C",
  "directive_verb": "رقم",
  "description": "One big number that counts up as it lands, with a short label under it. Use for a figure that was just said out loud.",
  "fields": [
    {
      "name": "value",
      "label": "Number",
      "type": "text",
      "max_length": 16,
      "default": "100",
      "description": "The number itself, digits only (grouping is added automatically)."
    },
    {
      "name": "start",
      "label": "Start from",
      "type": "text",
      "max_length": 16,
      "default": "0",
      "description": "The number the count begins at. Usually 0."
    },
    {
      "name": "step",
      "label": "Increase by",
      "type": "text",
      "max_length": 16,
      "default": "",
      "description": "How much the number jumps each tick, e.g. 200. Leave empty to divide the climb evenly."
    },
    {
      "name": "label",
      "label": "Label",
      "type": "text",
      "max_length": 40,
      "default": "",
      "description": "What the number measures. Two or three words."
    },
    {
      "name": "prefix",
      "label": "Prefix",
      "type": "text",
      "max_length": 6,
      "default": "",
      "description": "Symbol before the number, e.g. $."
    },
    {
      "name": "suffix",
      "label": "Suffix",
      "type": "text",
      "max_length": 6,
      "default": "",
      "description": "Symbol after the number, e.g. % or x."
    },
    {
      "name": "decimals",
      "label": "Decimal places",
      "type": "number",
      "control": "integer",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 0,
      "description": "Digits after the point."
    }
  ],
  "variants": {
    "horizontal": {
      "x": 0.5,
      "y": 0.24,
      "scale": 1.0,
      "max_width": 0.42
    },
    "vertical": {
      "x": 0.5,
      "y": 0.26,
      "scale": 0.95,
      "max_width": 0.78
    }
  },
  "motion": {
    "in": {
      "type": "spring",
      "stiffness": 230,
      "damping": 16,
      "ms": 700,
      "from": {
        "opacity": 0,
        "scale": 0.5,
        "y": -50,
        "rotate": -3
      }
    },
    "out": {
      "type": "ease",
      "easing": "inCubic",
      "ms": 250,
      "to": {
        "opacity": 0,
        "scale": 0.93,
        "y": 16
      }
    },
    "shadow": {
      "layers": 3,
      "elevation": 30,
      "opacity": 0.46,
      "lift": true
    },
    "blur": {
      "motion": true,
      "max": 7
    },
    "stagger": {
      "step_ms": 70,
      "elements": [
        "card",
        "number",
        "label"
      ]
    },
    "value": {
      "ms": 1000,
      "steps": 10,
      "ratio": 1.145,
      "steps_from": {
        "value": "value",
        "start": "start",
        "step": "step"
      }
    }
  },
  "sfx": [
    {
      "file": "_shared/sfx/count-wood.wav",
      "follow_value": "number",
      "gain": 0.22
    }
  ],
  "assets": [],
  "default_duration": 3.0
}
